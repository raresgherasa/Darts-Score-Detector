# ── Python & virtual environments ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env

# ── IDEs / editor / agent tooling ──────────────────────────────────────────
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# ── Datasets (re-download from Roboflow / regenerate locally) ───────────────
# Raw segmentation exports under any of these names:
darts_dataset/
yolov11 dataset/
Darts.yolo26/
Dorts.yolo26/
# Converted pose dataset (regenerate with convert_seg_to_pose.py):
darts_pose_dataset/
yolov11_pose_dataset/
# Captured frames / scratch annotation data:
data/
*.cache

# ── Model weights ───────────────────────────────────────────────────────────
# Ignore all weights by default (base checkpoints, ONNX exports, training runs)…
*.pt
*.onnx
*.pth
runs/
# …but DO track the two shipped, trained weights so the repo runs out of the box.
!models/
!models/**/*.pt

# ── Large media (sample clips, rendered output) ─────────────────────────────
*.mp4
*.mov
*.avi
*.mkv

# ── Developer scratch scripts (one-off debugging; documented in the README) ──
scratch/

# ── Internal working notes (planning / lessons; not part of the product) ─────
tasks/

# ── Misc local notes / test output ───────────────────────────────────────────
shortCMDs.md
test_out/
test_out_new/
test_out_pose_new/

# ── Loose image files (datasets/captures only; none are tracked in repo root) ─
*.jpg
*.jpeg
*.png
*.bmp
*.webp

# ── Allow assets for documentation ──────────────────────────────────────────
!assets/
!assets/**/*.png
